+/// Drives the system's D-pad from the left stick when nothing is bound to that axis.
+- (BOOL)OE_moveUnboundLeftStick:(OEHIDEvent *)anEvent previousState:(OEJoystickState_Axis)prevState
+{
+    OEHIDEventAxis axis = [anEvent axis];
+    if(_dpadKeys.count != HAT_COUNT || (axis != OEHIDEventAxisX && axis != OEHIDEventAxisY)) return NO;
+    if([_keyMap systemKeyForEvent:[anEvent axisEventWithDirection:OEHIDEventAxisDirectionNegative]] ||
+       [_keyMap systemKeyForEvent:[anEvent axisEventWithDirection:OEHIDEventAxisDirectionPositive]]) return NO;
+
+    auto player = _devicePlayers.find(anEvent.deviceHandler.deviceIdentifier);
+    if(player == _devicePlayers.end()) return NO;
+
+    OEKeyBindingDescription *(^keyForDirection)(OEHIDEventAxisDirection) = ^OEKeyBindingDescription *(OEHIDEventAxisDirection dir) {
+        if(dir == OEHIDEventAxisDirectionNull) return nil;
+        BOOL negative = dir == OEHIDEventAxisDirectionNegative;
+        // HID Y is positive downwards.
+        return self->_dpadKeys[axis == OEHIDEventAxisX ? (negative ? WEST : EAST) : (negative ? NORTH : SOUTH)];
+    };
+
+    BOOL wasPressed = ABS(prevState.value) >= _analogToDigitalThreshold;
+    BOOL isPressed  = ABS([anEvent value]) >= _analogToDigitalThreshold;
+    OEKeyBindingDescription *prevKey = wasPressed ? keyForDirection(prevState.direction) : nil;
+    OEKeyBindingDescription *currKey = isPressed ? keyForDirection([anEvent direction]) : nil;
+    if(prevKey == currKey) return YES;
+
+    if(prevKey) _OEBasicSystemResponderReleaseSystemKey(self, [self emulatorKeyForKey:prevKey player:player->second], NO);
+    if(currKey) _OEBasicSystemResponderPressSystemKey(self, [self emulatorKeyForKey:currKey player:player->second], NO);
+    return YES;
+}
